    "/api/turn/apply": {
      "post": {
        "operationId": "applyTurn",
        "summary": "Aplica una accion canonica validada. Usar solo cuando corresponde mutar estado de partida.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyTurnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Turno aplicado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          },
          "400": {
            "description": "Mutacion rechazada por validacion."
          }
        }
      }
    },
