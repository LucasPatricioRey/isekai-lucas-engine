{
  "openapi": "3.1.0",
  "info": {
    "title": "Isekai Lucas Engine GPT Actions",
    "version": "0.22.0",
    "description": "Schema normal para GPT Actions. Expone endpoints de lectura, busqueda, preview y mutacion central controlada. No expone rollback, admin ni mutadores peligrosos de combate/misiones."
  },
  "servers": [
    {
      "url": "https://isekai-lucas-engine.onrender.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "GenericResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "PreviewResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "preview": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "ApplyTurnRequest": {
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "default": "isekai_lucas_main"
          },
          "actionSummary": {
            "type": "string"
          },
          "timeAdvance": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "to": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          },
          "lucasPatch": {
            "type": "object",
            "additionalProperties": true
          },
          "inventoryPatch": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "skillPatch": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check publico del backend.",
        "security": [],
        "responses": {
          "200": {
            "description": "Backend disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/context/full": {
      "get": {
        "operationId": "getFullContext",
        "summary": "Obtiene estado vivo cercano: GameState, ubicacion, NPCs cercanos, rumores, tiendas, misiones y combate.",
        "responses": {
          "200": {
            "description": "Contexto vivo cercano.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/search/db": {
      "get": {
        "operationId": "searchDatabase",
        "summary": "Busca entidades vivas en MongoDB, incluyendo NPCs, locations, rumores, items, shops, misiones, enemigos y eventos.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados de busqueda DB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/search/docs": {
      "get": {
        "operationId": "searchDocs",
        "summary": "Busca chunks indexados de rules_engine.md y world_bible.md.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados de busqueda documental.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/npcs/{npcId}/full": {
      "get": {
        "operationId": "getNpcFull",
        "summary": "Obtiene ficha completa de un NPC.",
        "parameters": [
          {
            "name": "npcId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "NPC completo.",
