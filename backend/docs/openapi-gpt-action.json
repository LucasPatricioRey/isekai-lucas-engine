{
  "openapi": "3.1.0",
  "info": {
    "title": "Isekai Lucas Engine GPT Actions",
    "version": "0.22.0",
    "description": "Schema normal para GPT Actions. Expone endpoints de lectura, busqueda, preview y mutacion central controlada. No expone rollback, admin ni mutadores peligrosos de combate/misiones."
  },
  "servers": [
    {
      "url": "https://isekai-lucas-engine.onrender.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "GenericResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "PreviewResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "preview": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "ApplyTurnRequest": {
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "default": "isekai_lucas_main"
          },
          "actionSummary": {
            "type": "string"
          },
          "timeAdvance": {
            "type": "object",
            "properties": {
              "fromDay": {
                "type": "integer",
                "minimum": 1,
                "description": "Dia actual de partida al inicio del avance. Si se omite, el backend usa currentDay del GameState."
              },
              "from": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "toDay": {
                "type": "integer",
                "minimum": 1,
                "description": "Dia de partida al final del avance. Obligatorio cuando to es menor que from por cruce de medianoche."
              },
              "to": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            },
            "description": "Avance de tiempo del turno. Para cruzar medianoche usar fromDay/toDay; ejemplo: Dia 10 23:00 -> Dia 11 06:00.",
            "additionalProperties": false
          },
          "lucasPatch": {
            "$ref": "#/components/schemas/LucasPatch"
          },
          "activityCost": {
            "$ref": "#/components/schemas/ActivityCostInput"
          },
          "gameStatePatch": {
            "$ref": "#/components/schemas/GameStatePatch"
          },
          "biologicalCostExemptReason": {
            "type": "string",
            "description": "Razon explicita para avanzar hasta una hora exacta sin activityCost/lucasPatch."
          },
          "inventoryPatch": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InventoryPatchItem"
            }
          },
          "skillPatch": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillPatchItem"
            }
          },
          "moneyPatch": {
            "$ref": "#/components/schemas/MoneyPatch"
          },
          "shopStockPatches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShopStockPatchItem"
            }
          },
          "npcMemoryPatches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NpcMemoryPatchItem"
            }
          },
          "missionPatch": {
            "$ref": "#/components/schemas/MissionPatchInput"
          },
          "eventLogs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventLogInput"
            }
          }
        },
        "additionalProperties": true
      },
      "MoneyPatch": {
        "type": "object",
        "properties": {
          "deltaCopper": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "deltaCopper"
        ],
        "additionalProperties": false
      },
      "LucasPatch": {
        "type": "object",
        "properties": {
          "lifeDelta": {
            "type": "integer"
          },
          "satietyDelta": {
            "type": "integer"
          },
          "energyDelta": {
            "type": "integer"
          },
          "mpDelta": {
            "type": "integer"
          },
          "addInjuries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "addConditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      },
      "ActivityCostInput": {
        "type": "object",
        "description": "Costo biologico declarativo. Entre horas se acumula; al llegar a :00 se procesa.",
        "properties": {
          "category": {
            "type": "string",
            "examples": [
              "viaje_caminata_suave",
              "trabajo_normal",
              "entreno_moderado"
            ]
          },
          "minutes": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          },
          "processingMode": {
            "type": "string",
            "enum": [
              "auto"
            ],
            "description": "auto: backend acumula o procesa segun la hora."
          },
          "sourceEventLogId": {
            "type": "string",
            "description": "Log origen si se migra un pendiente viejo."
          },
          "allowMinutesMismatch": {
            "type": "boolean",
            "description": "Solo true con overrideReason cuando el coste biologico cubre una ventana distinta al timeAdvance."
          },
          "overrideReason": {
            "type": "string",
            "description": "Motivo explicito para permitir que minutes no coincida con timeAdvance."
          }
        },
        "required": [
          "category",
          "minutes"
        ],
        "additionalProperties": false
      },
      "GameStatePatch": {
        "type": "object",
        "description": "Cambios tecnicos validados sobre GameState. Actualmente permite locationId.",
        "properties": {
          "locationId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "InventoryPatchItem": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "set_quantity"
            ]
          },
          "itemId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "condition": {
            "type": "string"
          },
          "equipped": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "op",
          "itemId",
          "quantity"
        ],
        "additionalProperties": false
      },
      "SkillPatchItem": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string"
          },
          "expDelta": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "skillId",
          "expDelta"
        ],
        "additionalProperties": false
      },
      "ShopStockPatchItem": {
        "type": "object",
        "properties": {
          "shopId": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          },
          "deltaQuantity": {
            "type": "integer"
          },
          "currentPriceCopper": {
            "type": "integer",
            "minimum": 0
          },
          "addScarcityFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "removeScarcityFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "shopId",
          "itemId",
          "deltaQuantity"
        ],
        "additionalProperties": false
      },
      "NpcMemoryPatchItem": {
        "type": "object",
        "properties": {
          "npcId": {
            "type": "string"
          },
          "fact": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "sourceType": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "certainty": {
            "type": "string"
          },
          "emotionalWeight": {
            "type": "string"
          },
          "privacyLevel": {
            "type": "string"
          },
          "canShare": {
            "type": "boolean"
          },
          "importance": {
            "type": "string"
          },
          "relatedNpcIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relatedLocationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "npcId",
          "fact"
        ],
        "additionalProperties": true
      },
      "MissionPatchInput": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/MissionPatchItem"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MissionPatchItem"
            }
          }
        ]
      },
      "MissionPatchItem": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "accept",
              "report"
            ]
          },
          "missionId": {
            "type": "string"
          },
          "characterId": {
            "type": "string",
            "default": "char_lucas"
          },
          "reportSummary": {
            "type": "string"
          },
          "proofStatus": {
            "type": "string",
            "enum": [
              "submitted"
            ]
          }
        },
        "required": [
          "op",
          "missionId"
        ],
        "additionalProperties": false
      },
      "EventLogInput": {
        "type": "object",
        "properties": {
          "logId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "hidden",
              "private",
              "local",
              "public"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "player_action",
              "system",
              "npc_action",
              "world_event",
              "admin",
              "system_correction",
              "mechanical_audit",
              "backend_validation",
              "admin_fix"
            ]
          },
          "involvedCharacterIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "involvedNpcIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "involvedFactionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "summary"
        ],
        "additionalProperties": true
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check publico del backend.",
        "security": [],
        "responses": {
          "200": {
            "description": "Backend disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/context/full": {
      "get": {
        "operationId": "getFullContext",
        "summary": "Obtiene contexto vivo amplio con logs resumidos por defecto.",
        "responses": {
          "200": {
            "description": "Contexto vivo cercano.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        },
        "description": "Lectura amplia para debug. Por defecto limita recentEventLogs a 10 y no incluye mechanicalChanges para evitar ResponseTooLargeError. Para debug pesado usar includeMechanicalChanges=true&logLimit=30.",
        "parameters": [
          {
            "name": "gameId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "isekai_lucas_main"
            }
          },
          {
            "name": "logLimit",
            "in": "query",
            "required": false,
            "description": "Cantidad de logs recientes. Default 10, maximo 30.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "default": 10
            }
          },
          {
            "name": "includeMechanicalChanges",
            "in": "query",
            "required": false,
            "description": "Incluir mechanicalChanges completos en recentEventLogs. Default false para evitar respuestas demasiado grandes.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ]
      }
    },
    "/api/search/db": {
      "get": {
        "operationId": "searchDatabase",
        "summary": "Busca entidades vivas en MongoDB, incluyendo NPCs, locations, rumores, items, shops, misiones, enemigos y eventos.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados de busqueda DB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/search/docs": {
      "get": {
        "operationId": "searchDocs",
        "summary": "Busca chunks indexados de rules_engine.md y world_bible.md.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados de busqueda documental.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/npcs/{npcId}/full": {
      "get": {
        "operationId": "getNpcFull",
        "summary": "Obtiene ficha completa de un NPC.",
        "parameters": [
          {
            "name": "npcId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "NPC completo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/locations/{locationId}/full": {
      "get": {
        "operationId": "getLocationFull",
        "summary": "Obtiene ficha completa de una ubicacion.",
        "parameters": [
          {
            "name": "locationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ubicacion completa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/turn/apply": {
      "post": {
        "operationId": "applyTurn",
        "summary": "Aplica una accion canonica validada. Usar solo cuando corresponde mutar estado de partida.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyTurnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Turno aplicado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          },
          "400": {
            "description": "Mutacion rechazada por validacion."
          }
        },
        "x-openai-isConsequential": true
      }
    },
    "/api/economy/shops": {
      "get": {
        "operationId": "listShops",
        "summary": "Lista shops vivos.",
        "parameters": [
          {
            "name": "locationId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "regionId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shops vivos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/economy/shops/{shopId}/stock": {
      "get": {
        "operationId": "getShopStock",
        "summary": "Obtiene stock de un shop.",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stock vivo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/economy/items/{itemId}": {
      "get": {
        "operationId": "getItem",
        "summary": "Obtiene item de catalogo.",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item de catalogo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/missions/board": {
      "get": {
        "operationId": "getMissionBoard",
        "summary": "Consulta cartelera de misiones sin aceptar nada.",
        "parameters": [
          {
            "name": "rank",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "riskLevel",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sourceFactionId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Misiones consultables.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/missions/{missionId}": {
      "get": {
        "operationId": "getMissionDetail",
        "summary": "Consulta detalle de una mision sin aceptarla.",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de mision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/combat/actions": {
      "get": {
        "operationId": "listCombatActions",
        "summary": "Lista acciones de combate disponibles para preview.",
        "responses": {
          "200": {
            "description": "Acciones de combate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/combat/enemies": {
      "get": {
        "operationId": "listCombatEnemies",
        "summary": "Lista templates de enemigos.",
        "responses": {
          "200": {
            "description": "Enemigos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/combat/enemies/{enemyId}": {
      "get": {
        "operationId": "getCombatEnemy",
        "summary": "Obtiene template de enemigo.",
        "parameters": [
          {
            "name": "enemyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Enemigo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/combat/encounters/active": {
      "get": {
        "operationId": "listActiveCombatEncounters",
        "summary": "Lista combates activos.",
        "responses": {
          "200": {
            "description": "Combates activos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/combat/encounters/{encounterId}": {
      "get": {
        "operationId": "getCombatEncounter",
        "summary": "Obtiene combate por id.",
        "parameters": [
          {
            "name": "encounterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Combate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/combat/encounters/{encounterId}/actions/preview": {
      "post": {
        "operationId": "previewCombatAction",
        "summary": "Previsualiza una accion de combate sin mutar estado, cerrar combate ni dar loot.",
        "parameters": [
          {
            "name": "encounterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "actionType"
                ],
                "properties": {
                  "gameId": {
                    "type": "string"
                  },
                  "actionType": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preview de accion de combate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewResponse"
                }
              }
            }
          }
        }
