{
  "openapi": "3.1.0",
  "info": {
    "title": "Isekai Lucas Engine GPT Actions Admin Read-Only",
    "version": "2.8.3",
    "description": "Schema opcional para una segunda Action tecnica segura. Solo incluye endpoints existentes read-only. Sus componentes documentan parches sociales y relationshipState efectivo, pero las rutas expuestas no incluyen applyTurn, rollback, reset, delete ni mutadores peligrosos. El backend genera eventos diarios con scheduler de manana y los expira con consecuencias pendientes."
  },
  "servers": [
    {
      "url": "https://isekai-lucas-engine-admin.onrender.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "GenericResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "PreviewResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "preview": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "ApplyTurnRequest": {
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "default": "isekai_lucas_main"
          },
          "actionSummary": {
            "type": "string"
          },
          "timeAdvance": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "to": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          },
          "lucasPatch": {
            "$ref": "#/components/schemas/LucasPatch"
          },
          "activityCost": {
            "$ref": "#/components/schemas/ActivityCostInput"
          },
          "gameStatePatch": {
            "$ref": "#/components/schemas/GameStatePatch"
          },
          "biologicalCostExemptReason": {
            "type": "string",
            "description": "Razon explicita para avanzar tiempo sin activityCost. Usar solo si no hay coste biologico real; minimo 8 caracteres. No reemplaza acumuladores de comida/actividad."
          },
          "inventoryPatch": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InventoryPatchItem"
            }
          },
          "skillPatch": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillPatchItem"
            }
          },
          "moneyPatch": {
            "$ref": "#/components/schemas/MoneyPatch"
          },
          "shopStockPatches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShopStockPatchItem"
            }
          },
          "npcMemoryPatches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NpcMemoryPatchItem"
            }
          },
          "npcRelationshipPatches": {
            "type": "array",
            "description": "Cambios numericos controlados de vinculo con Lucas. Usar solo tras evaluar reglas sociales; memoria NPC no reemplaza relacion.",
            "items": {
              "$ref": "#/components/schemas/NpcRelationshipPatchItem"
            }
          },
          "missionPatch": {
            "$ref": "#/components/schemas/MissionPatchInput"
          },
          "eventLogs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventLogInput"
            }
          },
          "worldEventPatches": {
            "type": "array",
            "description": "Parches de evento mundial. Usar para resolver/cancelar eventos existentes o crear eventos narrativos validados.",
            "items": {
              "$ref": "#/components/schemas/WorldEventPatchItem"
            }
          }
        },
        "additionalProperties": false
      },
      "MoneyPatch": {
        "type": "object",
        "properties": {
          "deltaCopper": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "deltaCopper"
        ],
        "additionalProperties": false
      },
      "LucasPatch": {
        "type": "object",
        "properties": {
          "lifeDelta": {
            "type": "integer"
          },
          "satietyDelta": {
            "type": "integer"
          },
          "energyDelta": {
            "type": "integer"
          },
          "mpDelta": {
            "type": "integer"
          },
          "addInjuries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "addConditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      },
      "ActivityCostInput": {
        "type": "object",
        "description": "Costo biologico declarativo calculado por backend. Todo timeAdvance positivo requiere activityCost o biologicalCostExemptReason. activityCost.minutes debe coincidir con timeAdvance salvo exemption u override validado.",
        "properties": {
          "category": {
            "type": "string",
            "examples": [
              "viaje_caminata_suave",
              "trabajo_normal",
              "entreno_moderado"
            ]
          },
          "minutes": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          },
          "allowMinutesMismatch": {
            "type": "boolean",
            "description": "Solo true con overrideReason cuando el coste biologico cubre una ventana distinta al timeAdvance."
          },
          "overrideReason": {
            "type": "string",
            "description": "Motivo explicito para permitir que minutes no coincida con timeAdvance."
          }
        },
        "required": [
          "category",
          "minutes"
        ],
        "additionalProperties": false
      },
      "GameStatePatch": {
        "type": "object",
        "description": "Cambios tecnicos validados sobre GameState. Actualmente permite locationId.",
        "properties": {
          "locationId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "InventoryPatchItem": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "set_quantity"
            ]
          },
          "itemId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "condition": {
            "type": "string"
          },
          "equipped": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "op",
          "itemId",
          "quantity"
        ],
        "additionalProperties": false
      },
      "SkillPatchItem": {
        "type": "object",
        "description": "Progreso de habilidad validado por backend. Requiere categoria canonica y motivo; expDelta es EXP base antes de multiplicadores.",
        "properties": {
          "skillId": {
            "type": "string"
          },
          "expDelta": {
            "type": "integer",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "description": "Categoria canonica de actividad para validar rango, por ejemplo trabajo_normal, buscar_detalles_30min, practica_basica_10_30min."
          },
          "reason": {
            "type": "string",
            "minLength": 8
          },
          "modifiers": {
            "type": "object",
            "description": "Multiplicadores validos. Aqua solo aplica a habilidades magicas; hasMaster representa practica guiada.",
            "properties": {
              "aquaBlessing": {
                "type": "boolean"
              },
              "hasMaster": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "skillId",
          "expDelta",
          "category",
          "reason"
        ],
        "additionalProperties": false
      },
      "ShopStockPatchItem": {
        "type": "object",
        "properties": {
          "shopId": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          },
          "deltaQuantity": {
            "type": "integer"
          },
          "currentPriceCopper": {
            "type": "integer",
            "minimum": 0
          },
          "addScarcityFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "removeScarcityFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "shopId",
          "itemId",
          "deltaQuantity"
        ],
        "additionalProperties": false
      },
      "NpcMemoryPatchItem": {
        "type": "object",
        "properties": {
          "npcId": {
            "type": "string"
          },
          "fact": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "sourceType": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "certainty": {
            "type": "string"
          },
          "emotionalWeight": {
            "type": "string"
          },
          "privacyLevel": {
            "type": "string"
          },
          "canShare": {
            "type": "boolean"
          },
          "importance": {
            "type": "string"
          },
          "relatedNpcIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relatedLocationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "npcId",
          "fact"
        ],
        "additionalProperties": true
      },
      "NpcRelationshipPatchItem": {
        "type": "object",
        "description": "Delta de relacion Lucas-NPC con ledger social diario. No usar para smalltalk ni farmeo social; justificar cada cambio.",
        "properties": {
          "npcId": {
            "type": "string"
          },
          "trustDelta": {
            "type": "integer",
            "minimum": -3,
            "maximum": 3
          },
          "familiarityDelta": {
            "type": "integer",
            "minimum": -3,
            "maximum": 3,
            "description": "Cambio de trato/historia compartida, no necesariamente positivo ni romantico."
          },
          "affectionDelta": {
            "type": "integer",
            "minimum": -3,
            "maximum": 3
          },
          "suspicionDelta": {
            "type": "integer",
            "minimum": -3,
            "maximum": 3
          },
          "respectDelta": {
            "type": "integer",
            "minimum": -3,
            "maximum": 3
          },
          "fearDelta": {
            "type": "integer",
            "minimum": -3,
            "maximum": 3
          },
          "jealousyDelta": {
            "type": "integer",
            "minimum": -3,
            "maximum": 3
          },
          "socialDebtDelta": {
            "type": "integer",
            "minimum": -3,
            "maximum": 3,
            "description": "Favor o deuda social practica. Positivo: el NPC le debe algo a Lucas; negativo: Lucas queda en deuda o danio social."
          },
          "reason": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "actionType": {
            "type": "string",
            "description": "Tipo normalizado de accion social para antifarmeo: reliable_work, practical_help, respect_boundaries, apology, emotional_support, etc."
          },
          "overrideDailyCap": {
            "type": "boolean",
            "default": false,
            "description": "Solo true con overrideReason cuando un evento fuerte justifica superar el cap diario."
          },
          "overrideReason": {
            "type": "string",
            "description": "Motivo explicito para superar caps diarios."
          },
          "sourceEventId": {
            "type": "string"
          },
          "sourceMissionId": {
            "type": "string"
          },
          "sourceEventLogId": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "npcId",
          "reason"
        ],
        "additionalProperties": false
      },
      "MissionPatchInput": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/MissionPatchItem"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MissionPatchItem"
            }
          }
        ]
      },
      "MissionPatchItem": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "accept",
              "report",
              "verify",
              "complete",
              "fail",
              "expire"
            ]
          },
          "missionId": {
            "type": "string"
          },
          "characterId": {
            "type": "string",
            "default": "char_lucas"
          },
          "reportSummary": {
            "type": "string"
          },
          "verificationSummary": {
            "type": "string"
          },
          "completionSummary": {
            "type": "string"
          },
          "failureReason": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "overrideReason": {
            "type": "string",
            "description": "Motivo explicito para expirar manualmente una mision antes de su vencimiento formal."
          },
          "proofStatus": {
            "type": "string",
            "enum": [
              "submitted",
              "verified",
              "rejected"
            ]
          }
        },
        "required": [
          "op",
          "missionId"
        ],
        "additionalProperties": false
      },
      "EventLogInput": {
        "type": "object",
        "properties": {
          "logId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "hidden",
              "private",
              "local",
              "public"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "player_action",
              "system",
              "npc_action",
              "world_event",
              "admin",
              "system_correction",
              "mechanical_audit",
              "backend_validation",
              "admin_fix"
            ]
          },
          "involvedCharacterIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "involvedNpcIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "involvedFactionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "summary"
        ],
        "additionalProperties": true
      },
      "WorldEventEffectInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "value": {
            "type": "object",
            "additionalProperties": true
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": true
      },
      "WorldEventPatchItem": {
        "type": "object",
        "description": "Crea o actualiza WorldEvent dentro de applyTurn. Para resolver uno existente alcanza eventId + status; el backend conserva los datos previos.",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "gameId": {
            "type": "string",
            "default": "isekai_lucas_main"
          },
          "title": {
            "type": "string",
            "description": "Obligatorio solo al crear un evento nuevo."
          },
          "type": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "local",
              "regional",
              "national",
              "continental"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "active",
              "resolved",
              "expired",
              "consequences_applied",
              "cancelled"
            ]
          },
          "startDay": {
            "type": "integer",
            "minimum": 1
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "endDay": {
            "type": "integer",
            "minimum": 1
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "affectedLocationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affectedNpcIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affectedFactionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorldEventEffectInput"
            }
          },
          "visibility": {
            "type": "string",
            "enum": [
              "hidden",
              "private",
              "local",
              "public"
            ]
          },
          "cause": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "moderate",
              "major",
              "critical"
            ]
          },
          "createdBy": {
            "type": "string",
            "enum": [
              "system",
              "player_action",
              "npc_action",
              "world_tick",
              "admin"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applySocialConsequences": {
            "type": "boolean",
            "default": true,
            "description": "Para eventos diarios: si true, resolver/vencer el evento puede crear parches sociales sobre affectedNpcIds."
          },
          "socialOutcome": {
            "type": "string",
            "enum": [
              "resolved",
              "resolved_partial",
              "ignored",
              "failed",
              "none"
            ],
            "description": "Resultado social opcional del evento diario. Si se omite, se infiere desde status."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check publico del backend.",
        "security": [],
        "responses": {
          "200": {
            "description": "Backend disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/context/full": {
      "get": {
        "operationId": "getFullContext",
        "summary": "Obtiene contexto vivo amplio con logs resumidos por defecto.",
        "responses": {
          "200": {
            "description": "Contexto vivo cercano.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "x-openai-isConsequential": false,
        "description": "Lectura amplia para debug. Por defecto limita recentEventLogs a 10 y no incluye mechanicalChanges para evitar ResponseTooLargeError. Para debug pesado usar includeMechanicalChanges=true&logLimit=30.",
        "parameters": [
          {
            "name": "gameId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "isekai_lucas_main"
            }
          },
          {
            "name": "logLimit",
            "in": "query",
            "required": false,
            "description": "Cantidad de logs recientes. Default 10, maximo 30.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "default": 10
            }
          },
          {
            "name": "includeMechanicalChanges",
            "in": "query",
            "required": false,
            "description": "Incluir mechanicalChanges completos en recentEventLogs. Default false para evitar respuestas demasiado grandes.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ]
      }
    },
    "/api/search/db": {
      "get": {
        "operationId": "searchDatabase",
        "summary": "Busca entidades vivas en MongoDB, incluyendo NPCs, locations, rumores, items, shops, misiones, enemigos y eventos.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados de busqueda DB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "x-openai-isConsequential": false
      }
    },
    "/api/search/docs": {
      "get": {
        "operationId": "searchDocs",
        "summary": "Busca chunks indexados de rules_engine.md y world_bible.md.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados de busqueda documental.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "x-openai-isConsequential": false
      }
    },
    "/api/missions/board": {
      "get": {
        "operationId": "getMissionBoard",
        "summary": "Consulta cartelera de misiones sin aceptar nada.",
        "parameters": [
          {
            "name": "rank",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "riskLevel",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sourceFactionId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Misiones consultables.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "x-openai-isConsequential": false
      }
    },
    "/api/missions/{missionId}": {
      "get": {
        "operationId": "getMissionDetail",
        "summary": "Consulta detalle de una mision sin aceptarla.",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de mision.",
            "content": {
              "application/json": {
                "schema": {
